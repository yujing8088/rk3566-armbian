diff --git a/drivers/gpu/drm/panel/panel-simple.c b/drivers/gpu/drm/panel/panel-simple.c
index a944c34..09ebd20 100644
--- a/drivers/gpu/drm/panel/panel-simple.c
+++ b/drivers/gpu/drm/panel/panel-simple.c
@@ -157,6 +157,10 @@ struct panel_simple {
 
 	struct gpio_desc *enable_gpio;
 
+	/* optional hard reset line and DSI handle for DCS init (see below) */
+	struct gpio_desc *reset_gpio;
+	struct mipi_dsi_device *dsi;
+
 	const struct drm_edid *drm_edid;
 
 	struct drm_display_mode override_mode;
@@ -346,6 +350,31 @@ static int panel_simple_resume(struct device *dev)
 	if (p->desc->delay.prepare)
 		msleep(p->desc->delay.prepare);
 
+	/* Hard reset the panel if a reset line is wired up. */
+	if (p->reset_gpio) {
+		gpiod_set_value_cansleep(p->reset_gpio, 1);
+		msleep(20);
+		gpiod_set_value_cansleep(p->reset_gpio, 0);
+		msleep(60);
+	}
+
+	/*
+	 * Self-initialising DSI panels (common on cheap Rockchip boards)
+	 * only need the sleep-out (11h) and display-on (29h) DCS commands.
+	 * Send them here when the panel is attached on a MIPI-DSI bus.
+	 */
+	if (p->dsi) {
+		err = mipi_dsi_dcs_exit_sleep_mode(p->dsi);
+		if (err)
+			dev_warn(dev, "failed to exit sleep mode: %d\n", err);
+		msleep(120);
+
+		err = mipi_dsi_dcs_set_display_on(p->dsi);
+		if (err)
+			dev_warn(dev, "failed to set display on: %d\n", err);
+		msleep(20);
+	}
+
 	return 0;
 }
 
@@ -693,6 +722,12 @@ static struct panel_simple *panel_simple_probe(struct device *dev)
 		return dev_err_cast_probe(dev, panel->enable_gpio,
 					  "failed to request GPIO\n");
 
+	panel->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						    GPIOD_OUT_LOW);
+	if (IS_ERR(panel->reset_gpio))
+		return dev_err_cast_probe(dev, panel->reset_gpio,
+					  "failed to request reset GPIO\n");
+
 	err = drm_of_get_panel_orientation(dev->of_node, &panel->orientation);
 	if (err) {
 		dev_err(dev, "%pOF: failed to get orientation %d\n", dev->of_node, err);
@@ -6568,8 +6603,54 @@ static const struct panel_desc_dsi tsd_tst070wsbe_196c = {
 	.lanes = 4,
 };
 
+static const struct drm_display_mode evb2_lp4x_800x1280_mode = {
+	.clock = 70000,
+	.hdisplay = 800,
+	.hsync_start = 800 + 52,
+	.hsync_end = 800 + 52 + 8,
+	.htotal = 800 + 52 + 8 + 48,
+	.vdisplay = 1280,
+	.vsync_start = 1280 + 16,
+	.vsync_end = 1280 + 16 + 6,
+	.vtotal = 1280 + 16 + 6 + 15,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+	.flags = DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_NVSYNC,
+};
+
+/*
+ * Generic 4-lane 800x1280 MIPI-DSI panel found on Rockchip RK3566
+ * EVB2 LP4X boards. The controller self-initialises and only needs
+ * the sleep-out (11h) and display-on (29h) DCS commands, which the
+ * panel-simple DSI glue above sends from its resume path.
+ */
+static const struct panel_desc_dsi evb2_lp4x_800x1280 = {
+	.desc = {
+		.modes = &evb2_lp4x_800x1280_mode,
+		.num_modes = 1,
+		.bpc = 8,
+		.size = {
+			.width = 127,
+			.height = 203,
+		},
+		.delay = {
+			.prepare = 60,
+			.enable = 20,
+			.disable = 60,
+			.unprepare = 60,
+		},
+		.connector_type = DRM_MODE_CONNECTOR_DSI,
+	},
+	.flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+		 MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_NO_EOT_PACKET,
+	.format = MIPI_DSI_FMT_RGB888,
+	.lanes = 4,
+};
+
 static const struct of_device_id dsi_of_match[] = {
 	{
+		.compatible = "rockchip,evb2-lp4x-panel",
+		.data = &evb2_lp4x_800x1280
+	}, {
 		.compatible = "auo,b080uan01",
 		.data = &auo_b080uan01
 	}, {
@@ -6607,6 +6688,7 @@ static int panel_simple_dsi_probe(struct mipi_dsi_device *dsi)
 		return PTR_ERR(panel);
 
 	desc = container_of(panel->desc, struct panel_desc_dsi, desc);
+	panel->dsi = dsi;
 	dsi->mode_flags = desc->flags;
 	dsi->format = desc->format;
 	dsi->lanes = desc->lanes;
