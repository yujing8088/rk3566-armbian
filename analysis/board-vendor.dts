		BT,wake_host_irq = <0x121 0x10 0x0>;
		status = "okay";
		phandle = <0x1c7>;
	};
	leds {
		compatible = "gpio-leds";
		phandle = <0x1c8>;
		work_led {
			gpios = <0x82 0x13 0x0>;
			linux,default-trigger = "timer";
			phandle = <0x1c9>;
		};
		power_led {
			gpios = <0x82 0xa 0x0>;
			linux,default-trigger = "backlight";
			default-state = "on";
			phandle = <0x1ca>;
		};
	};
